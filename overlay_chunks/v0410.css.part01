/* VK Search v0.4.10 — one scale coordinate system for the entire application. */
html,
body,
#root {
  width: 100%;
  height: 100%;
  min-width: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

.app-viewport {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: var(--bg);
}

.app-scale-layer {
  position: relative;
  transform-origin: top left;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background: var(--bg);
}

.app-scale-layer > .app-shell {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  max-width: none;
  max-height: none;
}

/* v0.4.9 scaled only main; v0.4.10 explicitly removes that second scale. */
.work-scale-root {
  zoom: 1 !important;
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  min-height: 0 !important;
}

.sidebar {
  min-width: 0;
  min-height: 0;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  scrollbar-gutter: stable;
}

.sidebar nav {
  min-height: max-content;
}

.workspace,
.workspace main {
  min-width: 0;
  min-height: 0;
}

.workspace main {
  overflow: auto !important;
  scrollbar-gutter: stable both-edges;
}

.window-bar {
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: thin;
  flex-wrap: nowrap;
}

.window-bar > .icon-button,
.window-bar > .window-work-controls,
.window-bar > .window-indicators {
  flex-shrink: 0;
}

.window-bar .global-search {
  width: 290px;
  min-width: 180px;
  flex: 0 1 290px;
}

/* Portal lives in the same scaled coordinate system but outside page scroll/clipping. */
.app-overlay-root {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1000;
  overflow: visible;
}

.app-overlay-root > * {
  pointer-events: auto;
}

.scaled-overlay {
  z-index: 1001;
  width: max-content;
  max-width: calc(var(--logical-viewport-width) - 16px);
  max-height: calc(var(--logical-viewport-height) - 16px);
}

.app-overlay-root .context-menu {
  position: static !important;
  left: auto !important;
  right: auto !important;
  top: auto !important;
  bottom: auto !important;
  max-width: calc(var(--logical-viewport-width) - 16px);
  max-height: calc(var(--logical-viewport-height) - 16px);
  overflow: auto;
}

.app-overlay-root .account-menu {
  position: static !important;
  inset: auto !important;
  max-width: min(260px, calc(var(--logical-viewport-width) - 24px));
  max-height: calc(var(--logical-viewport-height) - 24px);
  overflow: auto;
}

.app-overlay-root .composer-popover {
  position: static !important;
  inset: auto !important;