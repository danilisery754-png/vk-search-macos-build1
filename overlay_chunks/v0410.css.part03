}

.page--inbox .inbox-layout {
  height: calc(var(--logical-viewport-height) - 155px);
  min-width: 0;
  min-inline-size: 720px;
  min-height: 0;
  grid-template-columns: minmax(250px, 34%) minmax(0, 1fr);
}

.page--inbox .conversation-list,
.page--inbox .chat-panel,
.page--inbox .messages-stage,
.page--inbox .messages-scroll,
.page--inbox .dialog-scroll {
  min-width: 0;
  min-height: 0;
}

.page--inbox .conversation-list,
.page--inbox .chat-panel {
  overflow: hidden;
}

.page--inbox .dialog-scroll,
.page--inbox .messages-scroll {
  overflow: auto;
  scrollbar-gutter: stable;
}

.chat-head,
.chat-peer,
.chat-head-actions {
  min-width: 0;
}

.chat-head-actions {
  flex: 0 0 auto;
}

/* Compact messenger composer: one line initially, grows through JS up to six lines. */
.composer {
  min-width: 0;
  grid-template-columns: minmax(0, 1fr) auto !important;
  align-items: end;
}

.composer textarea.composer-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 32px !important;
  max-height: 132px;
  height: 32px;
  padding: 6px 10px !important;
  line-height: 20px;
  resize: none;
  overflow-y: hidden;
  align-self: end;
}

.composer-control-stack {
  align-self: end;
  min-width: 92px;
  width: 92px;
}

/* Native audio controls must never disappear behind bubble overflow. */
.voice-card {
  min-width: 0;
  max-width: 100%;
  overflow: visible !important;
}

.voice-card audio.voice-player {
  display: block;
  width: min(320px, 100%);
  min-width: 180px;
  max-width: 100%;
  margin-top: 6px;
  overflow: visible;
}

.bubble--voice {
  overflow: visible;
  min-width: min(210px, 100%);
}

.message-photo {
  max-width: min(360px, 100%);
}

/* Explicit, immediate visual account reordering. */
.account-head {
  min-width: 0;
  gap: 8px;
}

.account-drag-handle {
  flex: 0 0 auto;
  width: 28px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: #71829e;
  cursor: grab;
  touch-action: none;
}

.account-drag-handle:hover,
.account-drag-handle:focus-visible {
  color: #b8c9e4;
  border-color: rgba(91, 143, 243, .28);
  background: rgba(91, 143, 243, .08);
  outline: none;
}

.account-drag-handle:active {
  cursor: grabbing;
}

.account-card--dragging {
  opacity: .58;
}

.account-card--drag-over {
  border-color: rgba(91, 143, 243, .78) !important;
  box-shadow: inset 0 0 0 1px rgba(91, 143, 243, .42), 0 12px 34px rgba(0, 0, 0, .24);
}

.account-menu {
  max-width: min(260px, calc(var(--logical-viewport-width) - 24px));
}